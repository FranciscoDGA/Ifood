# Banco de dados (Neon — integrado à Vercel: Storage → Create Database → Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Senha única de acesso ao painel (obrigatória)
APP_PASSWORD=troque-esta-senha

# Assinatura do cookie de sessão — gere com: openssl rand -hex 32
SESSION_SECRET=coloque-64-caracteres-aleatorios-aqui-por-favor

# Opcional: já pré-configura o segredo da URL do webhook.
# Se vazio, o app gera um sozinho na primeira execução.
WEBHOOK_SECRET=
